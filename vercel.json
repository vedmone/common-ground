{
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "rewrites":[{"source":"/project/:id","destination":"/api/site?id=:id"}],
  "functions":{"api/chat.js":{"maxDuration":180},"api/transcribe.js":{"maxDuration":60},"api/speak.js":{"maxDuration":60}},
  "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"Permissions-Policy","value":"microphone=(self), camera=()"}]}]
}
